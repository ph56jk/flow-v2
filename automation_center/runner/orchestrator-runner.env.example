# Do not commit a real copy of this file.  It contains runner, Access and OpenAI secrets.
#
# File .env RIENG, khong dung chung voi content-image-runner hay listing2-erp-runner:
# ba runner khac AUTOMATION_RUNNER_KEY, dung chung mot file se khien runner nay
# heartbeat nham key va cuop viec cua runner kia.
AUTOMATION_CENTER_URL=https://automation.havigroup.llc
AUTOMATION_RUNNER_KEY=orchestrator-runner
AUTOMATION_RUNNER_LABEL=Agent dieu phoi (may trung tam)
AUTOMATION_RUNNER_SECRET=replace-with-the-same-value-as-Cloudflare-RUNNER_SHARED_SECRET
# A Cloudflare Access Service Token restricted to Automation HaviGroup.
# Dung lai duoc dung cap token cua content-image-runner.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Ban sao repo RIENG cho agent, KHONG tro vao C:\HaviGroup\flow-v2 dang chay
# service: agent checkout qua lai giua cac nhanh, tro vao ban dang chay se lam
# Flow doc code nua chung.
AGENT_REPO_DIR=C:\HaviGroup\agent-workspace\flow-v2
AGENT_BASE_BRANCH=main

# De trong (hoac 0) thi agent chi merge vao nhanh base o ban sao noi bo, khong
# day len remote.  Bat len chi khi da co nhanh bao ve tren remote.
AGENT_PUSH_REMOTE=0

# Lenh test chay sau moi thay doi.  Khong dat thi moi thay doi deu bi coi la
# "chua co test xanh" va khong bao gio tu ap dung duoc.
#
# Lenh chay voi cwd = AGENT_REPO_DIR, nen duong dan tuong doi kieu
# `.venv\Scripts\python.exe` tro vao ban sao cua agent -- cho do khong co venv.
# Dung duong dan tuyet doi toi trinh thong dich cua repo service: no da co du
# thu vien, va khong ton them ~1 GB dia cho mot venv thu hai.
AGENT_TEST_COMMAND=C:\HaviGroup\flow-v2\.venv\Scripts\python.exe -m unittest discover -s tests -q
AGENT_TEST_TIMEOUT_SECONDS=900

# Nhip song rieng cho runner khi model/test dang chay lau. Mac dinh 15 giay,
# san 5 giay; dat nho hon 45 giay (nguong badge RUNNER_ONLINE_WITHIN_MS).
AGENT_HEARTBEAT_SECONDS=15

# Duong goi model: auto | openai | claude | codex.
# auto = co OPENAI_API_KEY thi di HTTP toi OpenAI, khong co thi Claude CLI,
# khong nua thi Codex CLI -- ca hai CLI dang nhap san nen khong can cat khoa
# API nao tren may nay.  May nao co du nhieu duong thi noi thang ten duong o
# day, dung de runner doan ho: mot lan doi duong khong ai hay la mot lan tra
# loi bang model khac, gia khac.
AGENT_MODEL_PROVIDER=auto

# Khoa OpenAI CHI nam o day, tren may trung tam.  Khong dua vao D1, public/,
# form cua Automation Center hay Git.  De trong neu di duong Claude/Codex CLI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Timeout nay dung chung cho ca ba duong (HTTP, claude, codex).
OPENAI_TIMEOUT_SECONDS=300

# Claude CLI (npm install -g @anthropic-ai/claude-code), phai dang nhap san
# bang chinh user chay Scheduled Task.  De trong thi runner tu tim "claude"
# trong PATH roi thu them %APPDATA%\npm\claude.cmd -- Scheduled Task kieu S4U
# co PATH hep hon phien dang nhap, nen tro duong dan tuyet doi (vi du
# C:\Users\Admin\AppData\Roaming\npm\claude.cmd) la chac chan nhat.
CLAUDE_BIN=
# Ten model cua claude ("haiku", "sonnet", "opus" hoac ten day du).  KHONG
# chep OPENAI_MODEL hay CODEX_MODEL vao day: ba duong khong chung bo ten model.
CLAUDE_MODEL=sonnet

# Codex CLI: de trong CODEX_BIN thi tim "codex" trong PATH.  CODEX_MODEL de
# trong thi dung model mac dinh cua codex.
CODEX_BIN=
CODEX_MODEL=

# ERP HaviGroup, doc-only.  Model khong bao gio tu goi ERP -- xin qua action
# "read" voi path dang "erp:MA_DU_AN"/"erp:MA_DU_AN/tasks"/"erp:MA_TASK",
# runner moi la ben goi GraphQL that su (xem runner/orchestrator_runner.py).
# Uu tien ERP_BOT_TOKEN; de trong thi dung cap ERP_API_KEY + ERP_API_SECRET
# kieu Frappe.  De trong ca hai thi ERP coi nhu chua cau hinh, agent tra loi
# ro vay thay vi hong ngam.  KHONG doc duoc tu macOS Keychain nhu
# mcp/hvg_erp_mcp.py -- may nay chay Windows.
ERP_BASE_URL=https://erp.havigroup.llc
ERP_BOT_TOKEN=
ERP_API_KEY=
ERP_API_SECRET=
